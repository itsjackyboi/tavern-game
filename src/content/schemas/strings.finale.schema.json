{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "placeholder": {
      "type": "boolean"
    },
    "titles": {
      "type": "object",
      "properties": {
        "monopoly": {
          "type": "string"
        },
        "sponsor": {
          "type": "string"
        },
        "lost": {
          "type": "string"
        },
        "bankrupt": {
          "type": "string"
        }
      },
      "required": [
        "monopoly",
        "sponsor",
        "lost",
        "bankrupt"
      ],
      "additionalProperties": false
    },
    "monopoly": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sponsor": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lost": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bankrupt": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freeplayNote": {
      "type": "string"
    }
  },
  "required": [
    "placeholder",
    "titles",
    "monopoly",
    "sponsor",
    "lost",
    "bankrupt",
    "freeplayNote"
  ],
  "additionalProperties": false
}
