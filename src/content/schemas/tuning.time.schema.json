{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ticksPerSecond": {
      "type": "number",
      "const": 20
    },
    "startYear": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "endYear": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "seasonOrder": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stormtide",
          "goldsun",
          "veilfrost"
        ]
      }
    },
    "seasonTicks": {
      "type": "object",
      "properties": {
        "stormtide": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "goldsun": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "veilfrost": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stormtide",
        "goldsun",
        "veilfrost"
      ],
      "additionalProperties": false
    },
    "dayFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lastCallTicks": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "holidayKegTicks": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxFrameMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ticksPerSecond",
    "startYear",
    "endYear",
    "seasonOrder",
    "seasonTicks",
    "dayFraction",
    "lastCallTicks",
    "holidayKegTicks",
    "maxFrameMs"
  ],
  "additionalProperties": false
}
