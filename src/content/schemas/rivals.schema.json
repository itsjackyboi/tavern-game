{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tavernNames": {
      "type": "object",
      "properties": {
        "aleforge": {
          "minItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "shanty": {
          "minItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "providence": {
          "minItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "roto": {
          "minItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "required": [
        "aleforge",
        "shanty",
        "providence",
        "roto"
      ],
      "additionalProperties": false
    },
    "archetypes": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "undercutter",
              "snob",
              "brawler",
              "briber"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "priceBias": {
            "type": "number"
          },
          "qualityBias": {
            "type": "number"
          },
          "aggression": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weights": {
            "type": "object",
            "properties": {
              "undercut": {
                "type": "number"
              },
              "copy": {
                "type": "number"
              },
              "quality": {
                "type": "number"
              },
              "promo": {
                "type": "number"
              },
              "sabotage": {
                "type": "number"
              },
              "bribe": {
                "type": "number"
              },
              "poach": {
                "type": "number"
              },
              "expand": {
                "type": "number"
              }
            },
            "required": [
              "undercut",
              "copy",
              "quality",
              "promo",
              "sabotage",
              "bribe",
              "poach",
              "expand"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "priceBias",
          "qualityBias",
          "aggression",
          "weights"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tavernNames",
    "archetypes"
  ],
  "additionalProperties": false
}
